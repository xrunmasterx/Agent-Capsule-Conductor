{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowGraph",
  "type": "object",
  "required": ["id", "version", "nodes", "edges"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
    "version": {"type": "string"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "input": {"type": "object"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "capsule_id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
        "capsule_id": {"type": "string"},
        "input": {"type": "object"},
        "position": {
          "type": "object",
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "to"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
        "from": {"type": "string"},
        "to": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
