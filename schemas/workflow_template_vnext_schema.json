{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowTemplateVNext",
  "type": "object",
  "required": [
    "id",
    "version",
    "nodes",
    "control_edges",
    "data_edges"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "control_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control_edge"
      }
    },
    "data_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/data_edge"
      }
    },
    "policies": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "agent",
            "tool",
            "workflow"
          ]
        },
        "runtime": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "workflow_ref": {
          "type": "string"
        },
        "ports": {
          "type": "object"
        },
        "prompt": {
          "type": "string"
        },
        "position": {
          "type": "object"
        },
        "policies": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "control_edge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "data_edge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "object",
          "required": [
            "node",
            "port"
          ],
          "properties": {
            "node": {
              "type": "string"
            },
            "port": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "to": {
          "type": "object",
          "required": [
            "node",
            "port"
          ],
          "properties": {
            "node": {
              "type": "string"
            },
            "port": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "materialization": {
          "enum": [
            "copy",
            "symlink",
            "reference"
          ],
          "default": "copy"
        }
      },
      "additionalProperties": false
    }
  }
}
