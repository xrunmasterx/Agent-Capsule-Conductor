{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACC Browser QA Report",
  "type": "object",
  "required": ["status", "journeys"],
  "properties": {
    "status": { "type": "string", "enum": ["passed", "failed", "partial", "blocked", "not_applicable"] },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "steps", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed", "blocked"] },
          "steps": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "issues": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": false
}
