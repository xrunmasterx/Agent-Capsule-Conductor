{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Browser E2E Report",
  "type": "object",
  "required": ["run_id", "started_at", "journeys", "summary"],
  "properties": {
    "run_id": { "type": "string" },
    "started_at": { "type": "string" },
    "ended_at": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["passed", "failed", "blocked"],
      "properties": {
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "blocked": { "type": "integer" }
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "enum": ["passed", "failed", "blocked"] },
          "notes": { "type": "string" },
          "evidence": {
            "type": "object",
            "properties": {
              "screenshots": { "type": "array", "items": { "type": "string" } },
              "console_log": { "type": "string" },
              "network_log": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
