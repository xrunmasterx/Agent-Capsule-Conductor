{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "session_id",
    "capsule_id",
    "capsule_version",
    "status",
    "created_at",
    "updated_at",
    "run_dir",
    "artifact_dir",
    "event_log_path",
    "conductor_output_path"
  ],
  "properties": {
    "session_id": { "type": "string", "pattern": "^session_" },
    "capsule_id": { "type": "string", "minLength": 1 },
    "capsule_version": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "running",
        "success",
        "failed",
        "timeout",
        "schema_error",
        "artifact_error",
        "unavailable"
      ]
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "run_dir": { "type": "string", "minLength": 1 },
    "workspace_dir": { "type": ["string", "null"] },
    "input_path": { "type": ["string", "null"] },
    "prompt_path": { "type": ["string", "null"] },
    "output_path": { "type": ["string", "null"] },
    "artifact_dir": { "type": "string", "minLength": 1 },
    "event_log_path": { "type": "string", "minLength": 1 },
    "conductor_output_path": { "type": "string", "minLength": 1 },
    "template_snapshot_dir": { "type": ["string", "null"] },
    "lifecycle_log_dir": { "type": ["string", "null"] },
    "capsule_kind": { "type": ["string", "null"] },
    "parent_workflow_run_id": { "type": ["string", "null"] },
    "parent_node_id": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
