{
  "id": "ac08_upstream_context_optin",
  "version": "0.1.0",
  "name": "AC8 Upstream Context Opt-In via Selector",
  "metadata": {
    "binding_mode": "explicit_only",
    "canonical_format": "accflow",
    "e2e_ac": "AC08"
  },
  "nodes": [
    {
      "id": "producer",
      "kind": "tool",
      "tool": "fake_producer",
      "output_ports": [
        {"id": "main", "direction": "output", "required": false}
      ]
    },
    {
      "id": "consumer_optin",
      "kind": "agent",
      "runtime": "generic_fake_agent",
      "prompt": "Opt in to upstream context via explicit selector.",
      "input_ports": [
        {"id": "main", "direction": "input", "required": false}
      ],
      "output_ports": [
        {"id": "main", "direction": "output", "required": false}
      ]
    },
    {
      "id": "consumer_optout",
      "kind": "agent",
      "runtime": "generic_fake_agent",
      "prompt": "Do not opt in - upstream context must be absent.",
      "input_ports": [
        {"id": "main", "direction": "input", "required": false}
      ],
      "output_ports": [
        {"id": "main", "direction": "output", "required": false}
      ]
    }
  ],
  "control_edges": [
    {"from": "producer", "to": "consumer_optin", "condition": null, "context": "none"},
    {"from": "producer", "to": "consumer_optout", "condition": null, "context": "none"}
  ],
  "data_edges": [],
  "policies": {"failure_mode": "fail_fast", "max_concurrency": 2}
}
