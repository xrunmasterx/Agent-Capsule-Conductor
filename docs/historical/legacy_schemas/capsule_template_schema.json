{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "version",
    "name",
    "description",
    "runtime",
    "permissions",
    "schema",
    "artifacts"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["atomic", "agent_session", "agent_workflow", "acc_workflow", "external_workflow"]
    },
    "runtime": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["generic_cli", "codex_cli", "claude_sdk", "acc_workflow"]
        },
        "command": { "type": ["string", "null"] },
        "args_base": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["existing_dir", "git_worktree_readonly", "git_worktree_write"]
        },
        "repo_path_input": { "type": ["string", "null"] },
        "base_ref": { "type": ["string", "null"] },
        "allowed_paths": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "required": ["timeout_seconds"],
      "properties": {
        "sandbox": { "type": "string" },
        "network": { "type": "boolean" },
        "write_files": { "type": "boolean" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "allow_dangerous": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "required": ["template"],
      "properties": {
        "template": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "schema": {
      "type": "object",
      "required": ["input", "output"],
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["manifest"],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "behavior_pack": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": { "type": "string", "enum": ["acc_graph", "conductor", "custom"] },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "setup": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "run": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "collect": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "cleanup": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
