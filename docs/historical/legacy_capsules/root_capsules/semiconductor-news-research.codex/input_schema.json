{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["market", "sector", "lookback_days", "tickers", "research_question"],
  "properties": {
    "market": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "lookback_days": {
      "type": "integer",
      "minimum": 1
    },
    "tickers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "research_question": {
      "type": "string"
    },
    "as_of_date": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
