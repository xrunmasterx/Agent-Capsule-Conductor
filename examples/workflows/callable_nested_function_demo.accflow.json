{
  "id": "callable_nested_function_demo",
  "version": "0.1.0",
  "name": "Callable Nested Function Demo",
  "nodes": [
    {
      "id": "producer",
      "kind": "tool",
      "tool": "fake_producer",
      "ports": {
        "outputs": {
          "main": {
            "type": "artifact"
          }
        }
      }
    },
    {
      "id": "subflow",
      "kind": "workflow",
      "workflow_ref": "callable_child_function.accflow.json",
      "ports": {
        "inputs": {
          "brief": {
            "type": "artifact"
          }
        },
        "outputs": {
          "summary": {
            "type": "artifact"
          }
        }
      },
      "workflow_call_input_bindings": [
        {
          "source": {
            "node": "producer",
            "port": "main"
          },
          "workflow_input": "brief",
          "materialization": "copy",
          "required": true
        }
      ],
      "workflow_call_output_bindings": [
        {
          "workflow_output": "report",
          "parent_port": "summary",
          "materialization": "copy",
          "required": true
        }
      ]
    },
    {
      "id": "final_merge",
      "kind": "tool",
      "tool": "merge",
      "ports": {
        "inputs": {
          "summary": {
            "type": "artifact"
          }
        },
        "outputs": {
          "bundle": {
            "type": "artifact"
          }
        }
      }
    }
  ],
  "control_edges": [
    {
      "from": "producer",
      "to": "subflow"
    },
    {
      "from": "subflow",
      "to": "final_merge"
    }
  ],
  "data_edges": [
    {
      "from": {
        "node": "producer",
        "port": "main"
      },
      "to": {
        "node": "subflow",
        "port": "brief"
      },
      "materialization": "copy"
    },
    {
      "from": {
        "node": "subflow",
        "port": "summary"
      },
      "to": {
        "node": "final_merge",
        "port": "summary"
      },
      "materialization": "copy"
    }
  ],
  "policies": {
    "max_concurrency": 2,
    "failure_mode": "fail_fast"
  },
  "metadata": {
    "layout": "left-to-right"
  }
}
