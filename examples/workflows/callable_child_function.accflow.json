{
  "id": "callable_child_function",
  "version": "0.1.0",
  "name": "Callable Child Function Demo",
  "exposed_inputs": {
    "brief": {
      "direction": "input",
      "type": "artifact",
      "required": true
    }
  },
  "exposed_outputs": {
    "report": {
      "direction": "output",
      "type": "artifact",
      "required": true
    }
  },
  "workflow_input_bindings": [
    {
      "source_port": "brief",
      "target": {
        "node": "child_agent",
        "port": "main"
      },
      "materialization": "copy",
      "required": true
    }
  ],
  "workflow_output_bindings": [
    {
      "source": {
        "node": "child_agent",
        "port": "summary"
      },
      "target_port": "report",
      "materialization": "copy",
      "required": true
    }
  ],
  "nodes": [
    {
      "id": "child_agent",
      "kind": "agent",
      "runtime": "generic_fake_agent",
      "prompt": "Read explicit child workflow input from inbox.",
      "ports": {
        "inputs": {
          "main": {
            "type": "artifact"
          }
        },
        "outputs": {
          "summary": {
            "type": "artifact"
          }
        }
      }
    }
  ],
  "control_edges": [],
  "data_edges": [],
  "policies": {
    "max_concurrency": 1,
    "failure_mode": "fail_fast"
  },
  "metadata": {
    "layout": "left-to-right"
  }
}
